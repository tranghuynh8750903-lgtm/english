{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite.*dev.*server.*running.*",
          "endsPattern": "^.*Local:\\s+http://localhost:3000.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: dev"
    },
    {
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": [],
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "lint",
      "group": "test",
      "problemMatcher": "$tsc",
      "label": "npm: lint"
    }
  ]
}
